# PostgreSQL (docker compose сам связывает сервер с db, менять не нужно)
POSTGRES_USER=chrt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chrt_push

# Порт наружу для приложения (по умолчанию 4000)
# SERVER_PORT=4000

# Пароль входа в админ-дэшборд (/login) — ОБЯЗАТЕЛЬНО поменяйте!
ADMIN_PASSWORD=changeme

# Секрет для теста push-канала: POST /debug/simulate + заголовок X-Debug-Key
DEBUG_KEY=

# Источник расписания (опционально)
TIMET_BASE_URL=https://timet.eremin.tech
